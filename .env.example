# Copy to .env and fill in.
# Address printed in the access links: the LAN address of the machine running this server.
PUBLIC_BASE=http://<server-ip>:8787
# Login of AirGuard Web on the MQTT broker
MQTT_USERNAME=airguard
MQTT_PASSWORD=
# WhatsApp link: WHATSAPP=0 turns it off; WHATSAPP_GROUPS=1 also shows group messages
#WHATSAPP=1
#WHATSAPP_GROUPS=0
